# —— Obsidian 运行时文件（每次开关都会变，同步会导致冲突）——
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# —— 回收站与临时文件 ——
.trash/
*.tmp

# —— 插件私有数据（可能含 API Key / 访问令牌，推到 GitHub 有泄露风险）——
.obsidian/plugins/*/data.json

# —— 私人内容 ——
# 本仓库对外公开（供实验室负责人查看学习进度）
# 任何不想被外人看到的笔记，放进下面这个目录，永不入库
私人/
private/
个人/

# —— 系统垃圾文件 ——
.DS_Store
Thumbs.db
desktop.ini
